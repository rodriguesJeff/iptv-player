# Example only: placeholder values. Set the real ones in the Dokploy panel, never commit them.

# Required. Random, at least 32 bytes. Generate with: openssl rand -base64 48
SYNC_SECRET=change-me-generate-with-openssl-rand-base64-48

# Default IPTV server, used only when the user leaves the server empty or types the web deploy's
# own address. Anything else the user types is validated against that server instead.
IPTV_UPSTREAM=http://provedor.example:8080

# Public address of the web deploy (same as the browser URL).
PUBLIC_ORIGIN=https://tv.example.com

# Traefik + Caddy in front of the service append to X-Forwarded-For.
TRUSTED_PROXY_HOPS=2

# Optional
# SYNC_DATA_DIR=/data
# PORT=8790
# SESSION_TTL_HOURS=24
# SYNC_ALLOWED_HOSTS=provedor.example,outro.example   # restrict which IPTV hosts may use sync
# SYNC_ALLOW_PRIVATE=1                                # dev only (mock on localhost); refused in production
